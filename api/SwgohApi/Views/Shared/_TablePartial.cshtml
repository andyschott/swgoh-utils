@model ITableViewModel

<div class="table-content">
  <h2>@Model.Title</h2>

  <div id="filter-container">
    <input id="filter" placeholder="Enter a name">
  </div>

  <div class="table-scroll">
    <table class="data-table" id="data-table">
      <thead>
      <tr>
        @foreach (var column in Model.Columns)
        {
          <th scope="col">@column</th>
        }
      </tr>
      </thead>
      <tbody>
      @foreach (var id in Model.Items)
      {
        <tr>
          <th scope="row">@Model.GetText(id, Model.Columns.First())</th>
          @foreach (var column in Model.Columns.Skip(1))
          {
            <td class="@Model.GetCellClass(id, column)"
                title="@Model.GetCellToolip(id, column)">
              @Model.GetText(id, column)
            </td>
          }
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>
