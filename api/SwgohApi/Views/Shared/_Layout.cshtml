<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>@(!string.IsNullOrEmpty(ViewData["Title"] as string) ? $"{ViewData["Title"]} - Holocron Vault" : "Holocron Vault")</title>
  <meta name="color-scheme" content="dark light">
  <link rel="stylesheet" href="~/css/styles.css"/>
  @await RenderSectionAsync("Styles", required: false)
</head>

<body>
<header>
  <button class="hamburger" aria-label="Toggle navigation" aria-expanded="false" aria-controls="sidebar">
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
  </button>
  <h1><a asp-controller="Home" asp-action="Index">Holocron Vault</a></h1>
</header>

<div class="page-row">
  <div class="sidebar">
    <ul>
      <li>
        <a asp-controller="Characters" asp-action="Index">Characters</a>
        <ul>
          @if (User.Identity?.IsAuthenticated == true)
          {
            <li><a asp-controller="User" asp-action="CharactersIndex">Your Characters</a></li>
          }
          <li><a asp-controller="Marquees" asp-action="Index">Marquees</a></li>
          <lia><a asp-controller="ConquestRewards" asp-action="Index">Conquest Rewards</a></lia>
        </ul>
      </li>
      <li><a asp-controller="Ships" asp-action="Index">Ships</a></li>
      <ul>
        @if (User.Identity?.IsAuthenticated == true)
        {
          <li><a asp-controller="User" asp-action="ShipsIndex">Your Ships</a></li>
        }
      </ul>
      <li>
        <a asp-controller="RiseOfTheEmpireRewards" asp-action="Index">Rise of the Empire Rewards</a>
      </li>
      <li>
        @if (User.Identity?.IsAuthenticated == true)
        {
          <a asp-controller="Accounts" asp-action="Logout">Logout</a>
        }
        else
        {
          <a asp-controller="Accounts" asp-action="Login">Login</a>
        }
      </li>
    </ul>
  </div>
  <div class="overlay"></div>
  <div class="content">
    @RenderBody()
  </div>
</div>

<script src="~/scripts/main.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
